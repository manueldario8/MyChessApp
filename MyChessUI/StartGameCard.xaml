<UserControl x:Class="MyChessUI.StartGameCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyChessUI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Border Width="350" Height="250" Style="{StaticResource BorderStyle}">
        <Grid RenderOptions.BitmapScalingMode="HighQuality">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.7*">

                </RowDefinition>

                <RowDefinition Height="1.5*">

                </RowDefinition>
            </Grid.RowDefinitions>

            <TextBlock Text="SELECT SIDE" Style="{StaticResource TextStyle}" FontSize="28"/>

            <UniformGrid Grid.Row="1" Rows="1" Columns="2" Cursor="Hand">
                
                <Border BorderBrush="Gray" BorderThickness="3" CornerRadius="4" Padding="3" Margin="7">
                    
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1.03" ScaleY="1.03"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Image x:Name="QueenWImg" MouseDown="WhiteSide_MouseDown" Source="/Assets/QueenW.png"/>
                </Border>
                <!--Black side-->
                
                <Border BorderBrush="Gray" BorderThickness="3" CornerRadius="4" Padding="3" Margin="7">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1.03" ScaleY="1.03"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Image x:Name="QueenBImg" MouseDown="BlackSide_MouseDown" Source="/Assets/QueenB.png"/>
                </Border>


            </UniformGrid>
        </Grid>
    </Border>
</UserControl>
