<UserControl x:Class="MyChessUI.StartGameCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyChessUI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Border Width="255" Height="280" Style="{StaticResource BorderStyle}">
        <Grid>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="226" Height="252">

                <GroupBox Header="GAME MODE" Style="{StaticResource GroupBoxStyle}" Margin="0,0,0,15" Width="170">
                    <StackPanel>
                        <RadioButton x:Name="rbHuman" Content="1 VS 1" IsChecked="True" 
                                     Style="{StaticResource RadioButtonStyle}"
                                     Checked="RbHuman_Checked"/>
                        <RadioButton x:Name="rbComputer" Content="1 VS COMPUTER" 
                                     Style="{StaticResource RadioButtonStyle}"
                                     Checked="RbComputer_Checked"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="CHOOSE SIDE" Style="{StaticResource GroupBoxStyle}" Width="170">
                    <StackPanel>
                        <RadioButton x:Name="rbWhite" Content="WHITE" IsChecked="True" 
                                     Style="{StaticResource RadioButtonStyle}" 
                                     Checked="WhitePlayer_Checked"/>
                        <RadioButton x:Name="rbBlack" Content="BLACK" 
                                     Style="{StaticResource RadioButtonStyle}" 
                                     Checked="BlackPlayer_Checked"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="SELECT LEVEL" Style="{StaticResource GroupBoxStyle}" Margin="0,0,0,10" Width="170">
                    <ComboBox x:Name="cbDifficulty" Width="150" SelectedIndex="0"/>
                </GroupBox>

                <Button Content="START GAME" Width="150" Height="40" 
                        Style="{StaticResource ButtonStyle}" 
                        Click="StartGame_Click"/>

            </StackPanel>
        </Grid>
    </Border>
</UserControl>
